{
  "name": "json-zen",
  "version": "2.0.0",
  "description": "The ultimate JSON toolkit - format, validate, fix, convert, transform, diff, and test APIs with a glassmorphism UI and 10 themes",
  "author": "Srinivas Pendela",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sriinnu/json-zen.git"
  },
  "homepage": "https://github.com/sriinnu/json-zen",
  "bugs": {
    "url": "https://github.com/sriinnu/json-zen/issues"
  },
  "keywords": [
    "json",
    "formatter",
    "validator",
    "minifier",
    "browser-extension",
    "chrome-extension",
    "json-schema",
    "json-converter",
    "yaml",
    "xml",
    "csv",
    "glassmorphism",
    "developer-tools"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "echo 'No build step required - load json-zen-extension/ as unpacked extension'",
    "zip": "cd json-zen-extension && zip -r ../json-zen-v$npm_package_version.zip . -x '*.DS_Store' -x '__MACOSX/*'"
  }
}
