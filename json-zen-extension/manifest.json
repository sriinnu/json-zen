{
  "manifest_version": 3,
  "name": "JSON Zen",
  "version": "2.0.0",
  "description": "Ultimate JSON Toolkit with HTTP Client, Diff & more - Beautiful glassmorphism UI",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "JSON Zen — open workspace",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "contextMenus",
    "activeTab",
    "tabs",
    "cookies",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"]
    }
  ],
  "commands": {
    "format-json": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Format JSON"
    },
    "minify-json": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Minify JSON"
    },
    "fix-json": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Fix JSON"
    },
    "validate-json": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Validate JSON"
    }
  }
}
