<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>JSON Zen</title>
  <link rel="stylesheet" href="popup.css">
</head>
<body>
  <!-- Header with glass effect -->
  <header class="header">
    <div class="logo">
      <div class="logo-icon-wrapper">
        <div class="logo-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
            <defs>
              <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#60A5FA"/>
                <stop offset="100%" style="stop-color:#3B82F6"/>
              </linearGradient>
            </defs>
            <path d="M7 5v4c0 1.1-.9 2-2 2s-2-.9-2-2V5c0-1.1.9-2 2-2" stroke="url(#logoGrad)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M17 5v4c0 1.1.9 2 2 2s2-.9 2-2V5c0-1.1-.9-2-2-2" stroke="url(#logoGrad)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="10" cy="6" r="1.5" fill="#60A5FA"/>
            <circle cx="10" cy="9" r="1.5" fill="#60A5FA"/>
            <path d="M7 14h8" stroke="url(#logoGrad)" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
      </div>
      <span class="logo-text">JSON Zen</span>
    </div>
    <div class="header-actions">
      <div class="status-pill" id="status">Ready</div>
      <button class="theme-toggle" id="theme" title="Toggle theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- Toolbar with glass buttons -->
  <div class="toolbar">
    <button class="btn btn-primary" id="format">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M4 6h16M4 12h12M4 18h16" stroke-linecap="round"/>
      </svg>
      Format
    </button>
    <button class="btn btn-secondary" id="minify">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/>
      </svg>
      Minify
    </button>
    <button class="btn btn-fix" id="fix">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M14.5 4h-5L7 7H4a2 2 0 00-2 2v9a2 2 0 002 2h3l2.5 3h5a2 2 0 002-2V6a2 2 0 00-2-2z"/>
        <path d="M9 12l2 2 4-4"/>
      </svg>
      Fix
    </button>
    <button class="btn btn-secondary" id="validate">Validate</button>
    <button class="btn btn-schema" id="schemaValidate">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M9 12l2 2 4-4"/>
        <rect x="3" y="3" width="18" height="18" rx="2" stroke-dasharray="4 2"/>
      </svg>
      Schema
    </button>
    <div class="divider"></div>
    <button class="btn btn-secondary" id="sort">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M3 6h18M3 12h18M3 18h18"/>
      </svg>
      Sort
    </button>
    <button class="btn btn-secondary" id="stats">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <rect x="3" y="3" width="7" height="18" rx="1"/>
        <rect x="14" y="8" width="7" height="13" rx="1"/>
      </svg>
      Stats
    </button>
    <button class="btn btn-secondary" id="diffBtn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M12 20V4M5 13l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Diff
    </button>
    <div class="dropdown">
      <button class="btn btn-secondary dropdown-toggle" id="convertBtn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18"/>
          <path d="M9 6v12m0-6l-3 3m3-3l3 3" stroke-linecap="round" stroke-linejoin="round" transform="translate(12,0)"/>
        </svg>
        Convert
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </button>
      <div class="dropdown-menu" id="convertMenu">
        <button class="dropdown-item" data-convert="yaml">
          <span style="display:inline-block;width:20px;">📄</span> YAML
        </button>
        <button class="dropdown-item" data-convert="xml">
          <span style="display:inline-block;width:20px;">🏷️</span> XML
        </button>
        <button class="dropdown-item" data-convert="csv">
          <span style="display:inline-block;width:20px;">📊</span> CSV
        </button>
        <button class="dropdown-item" data-convert="toml">
          <span style="display:inline-block;width:20px;">⚙️</span> TOML
        </button>
        <div class="dropdown-divider"></div>
        <button class="dropdown-item" data-convert="base64">
          <span style="display:inline-block;width:20px;">🔐</span> Base64
        </button>
        <button class="dropdown-item" data-convert="url">
          <span style="display:inline-block;width:20px;">🔗</span> URL Encode
        </button>
      </div>
    </div>
  </div>

  <!-- Main content with glass panels -->
  <div class="main">
    <!-- Input panel -->
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">Input</span>
        <div class="panel-actions">
          <button class="icon-btn" id="paste" title="Paste from clipboard">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2"/>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
            </svg>
          </button>
          <button class="panel-btn danger" id="clear">Clear</button>
        </div>
      </div>
      <textarea id="input" placeholder="Paste your JSON here to format, validate, or fix..."></textarea>
    </div>

    <!-- Output panel -->
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">Output</span>
        <div class="panel-actions">
          <span class="char-count" id="info">0 chars</span>
          <button class="panel-btn" id="copy">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:4px;">
              <rect x="9" y="9" width="13" height="13" rx="2"/>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
            </svg>
            Copy
          </button>
        </div>
      </div>
      <pre id="output"></pre>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <span class="shortcut"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>F</kbd> Format</span>
    <span class="shortcut"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>M</kbd> Minify</span>
    <span class="shortcut"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>X</kbd> Fix</span>
    <span class="shortcut"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>V</kbd> Validate</span>
    <span class="credit">by Srinivas Pendela</span>
  </footer>

  <!-- Schema Validation Modal -->
  <div class="modal-overlay" id="schemaModal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title">JSON Schema Validation</h2>
        <button class="modal-close" id="closeSchemaModal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="modal-body">
        <!-- Template Selector -->
        <div class="schema-toolbar">
          <div class="template-selector">
            <label for="schemaTemplate">Template:</label>
            <select id="schemaTemplate" class="template-select">
              <option value="">-- Select Template --</option>
              <option value="user">User Profile</option>
              <option value="config">Configuration</option>
              <option value="api-response">API Response</option>
              <option value="product">Product</option>
              <option value="address">Address</option>
            </select>
          </div>
          <div class="schema-actions">
            <button class="schema-action-btn" id="generateSchema" title="Generate schema from JSON">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
              </svg>
              Generate Schema
            </button>
            <button class="schema-action-btn" id="clearSchema" title="Clear schema">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
              </svg>
              Clear
            </button>
          </div>
        </div>

        <!-- Two Panel Layout -->
        <div class="schema-panels">
          <!-- JSON Panel -->
          <div class="schema-panel">
            <div class="schema-panel-header">
              <span class="schema-panel-title">JSON Data</span>
              <span class="schema-panel-status" id="jsonStatus"></span>
            </div>
            <textarea id="schemaJsonInput" class="schema-textarea" placeholder="Enter your JSON data to validate..."></textarea>
          </div>

          <!-- Schema Panel -->
          <div class="schema-panel">
            <div class="schema-panel-header">
              <span class="schema-panel-title">JSON Schema (Draft 7)</span>
              <span class="schema-panel-status" id="schemaStatus"></span>
            </div>
            <textarea id="schemaInput" class="schema-textarea" placeholder="Enter or generate JSON schema..."></textarea>
          </div>
        </div>

        <!-- Validation Results -->
        <div class="validation-results" id="validationResults">
          <div class="validation-summary" id="validationSummary"></div>
          <div class="validation-errors" id="validationErrors"></div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" id="cancelSchema">Cancel</button>
        <button class="btn btn-primary" id="runSchemaValidation">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M9 12l2 2 4-4"/>
          </svg>
          Validate
        </button>
      </div>
    </div>
  </div>

  <!-- Diff/Compare Modal -->
  <div class="modal-overlay" id="diffModal">
    <div class="modal-content diff-modal-content">
      <div class="modal-header">
        <h2 class="modal-title">JSON Diff Comparison</h2>
        <button class="modal-close" id="closeDiffModal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="modal-body diff-modal-body">
        <!-- Diff Controls -->
        <div class="diff-controls">
          <div class="diff-mode-selector">
            <label for="diffMode">Comparison Mode:</label>
            <select id="diffMode" class="diff-select">
              <option value="formatted">Formatted JSON</option>
              <option value="minified">Minified JSON</option>
            </select>
          </div>
          <div class="diff-actions">
            <button class="diff-action-btn" id="clearDiff" title="Clear comparison">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
              </svg>
              Clear
            </button>
            <button class="diff-action-btn diff-copy-changes" id="copyChanges" title="Copy only changes">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2"/>
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
              </svg>
              Copy Changes
            </button>
          </div>
        </div>

        <!-- Diff Panels -->
        <div class="diff-panels">
          <!-- Original JSON Panel -->
          <div class="diff-panel">
            <div class="diff-panel-header">
              <span class="diff-panel-title">Original JSON</span>
              <span class="diff-panel-status" id="originalStatus"></span>
            </div>
            <textarea id="originalJson" class="diff-textarea" placeholder="Paste original JSON here or use current input..."></textarea>
          </div>

          <!-- New JSON Panel -->
          <div class="diff-panel">
            <div class="diff-panel-header">
              <span class="diff-panel-title">New JSON</span>
              <span class="diff-panel-status" id="newStatus"></span>
            </div>
            <textarea id="newJson" class="diff-textarea" placeholder="Paste new JSON to compare..."></textarea>
          </div>
        </div>

        <!-- Diff Results -->
        <div class="diff-results">
          <div class="diff-summary" id="diffSummary"></div>
          <div class="diff-output" id="diffOutput">
            <div class="diff-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 20V4M5 13l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <p>Enter JSON in both panels to see differences</p>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" id="cancelDiff">Cancel</button>
        <button class="btn btn-primary" id="runDiff">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 20V4M5 13l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Compare
        </button>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="../utils/json-utils.js"></script>
  <script src="popup-script.js"></script>
</body>
</html>
